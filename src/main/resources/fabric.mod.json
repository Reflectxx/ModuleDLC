{
	"schemaVersion": 1,
	"id": "moduledlc",
	"version": "${version}",
	"name": "ModuleDLC",
	"description": "The Open Source Platform for Script testing",
	"contact": {
		"homepage": "https://reflectxx.github.io"
	},
	"license": "CC0-1.0",
	"icon": "assets/moduledlc/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.dlc.ModuleDLC"
		],
		"client": [
			"dev.dlc.client.ModuleDLCClient"
		]
	},
	"mixins": [
		"moduledlc.mixins.json",
		{
			"config": "moduledlc.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}